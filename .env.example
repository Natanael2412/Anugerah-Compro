# Anugerah Ventures — Environment Variables
# Copy file ini ke .env.local dan isi dengan nilai yang sesuai.
# JANGAN commit .env.local ke git (sudah ada di .gitignore).

# ============================================================
# SUPABASE — Auth + Database
# Ambil dari: Supabase Dashboard → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# ============================================================
# CLOUDFLARE R2 — Image & Asset Storage
# Ambil dari: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# ============================================================

# Account ID — Cloudflare Dashboard → kanan bawah
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 API Token credentials (buat di R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Nama bucket R2 yang dibuat
R2_BUCKET_NAME=anugerah-ventures

# Public URL bucket (pilih salah satu):
# - Custom domain: https://cdn.anugerahventures.id  (setelah setup di R2)
# - r2.dev URL:    https://pub-xxxx.r2.dev          (aktifkan di R2 bucket settings)
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.anugerahventures.id

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_SITE_URL=https://anugerahventures.id
